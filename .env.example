# Copy to .env and adjust. Every value below is a placeholder.
# Real environment variables always win over this file.

APP_ENV=local

# Product lines: name=database pairs, comma separated. The first one is used for
# connections when a query spans every line.
PRODUCT_LINES=auto=collections_auto,consumer=collections_consumer
DB_SCHEMA=dbo
DB_READ_HINT=WITH (NOLOCK)

# SQL Server connection (requires the "sqlserver" extra and an ODBC driver).
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_HOST=localhost
DB_PORT=1433
DB_USER=collections_reader
DB_PASSWORD=change-me
DB_TRUST_SERVER_CERT=false
DB_CONNECT_TIMEOUT=10
DB_QUERY_TIMEOUT=60
DB_POOL_SIZE=6
DB_POOL_MAX_AGE_SECONDS=1800

# Caches
CACHE_TTL_SECONDS=60
CACHE_MAX_ENTRIES=500
BENCHMARKS_CACHE_TTL_SECONDS=1800
AGENT_EFFORT_CACHE_TTL_SECONDS=60

# Authentication and rate limiting
REQUIRE_API_AUTH=false
API_KEY=change-me
API_TOKEN=change-me
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_BUCKETS=5000

# HTTP surface
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=false
# Empty means: serve the OpenAPI docs only when authentication is off.
ENABLE_DOCS=
# Directory with a built single-page app to serve next to the API. Empty disables it.
FRONTEND_DIST_DIR=

# Optional features
ENABLE_INDEX_ADMIN=false
EFFECTIVENESS_ETL_ENABLED=true
EFFECTIVENESS_ETL_INTERVAL_SECONDS=1800

# Telemetry (all optional)
ENABLE_TELEMETRY_LOG=false
TELEMETRY_LOG_PATH=logs/telemetry.ndjson
TELEMETRY_LOG_MAX_BYTES=5242880
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENABLE_LOGS=true
LOG_LEVEL=INFO

# Status catalogue and business rules. The defaults are invented: calibrate them
# on your own data.
STATUS_IDS=ACTIVE=21,BROKEN=22,PAID=23,PENDING_EXCEPTION=24,REJECTED=25,AUTO_BROKEN=26,PAID_MANUAL=27
# Optional overrides of derived status sets (comma separated status names):
# STATUS_SET_APPROVED=ACTIVE,PAID,PAID_MANUAL
# STATUS_SET_GENERATED=ACTIVE,PAID,PAID_MANUAL,BROKEN,AUTO_BROKEN
# STATUS_SET_EXCEPTION=PENDING_EXCEPTION
# STATUS_SET_REJECTED=REJECTED
# STATUS_SET_BROKEN=BROKEN
# STATUS_SET_AUTO_BROKEN=AUTO_BROKEN
# STATUS_SET_UNIVERSE=ACTIVE,PAID,PAID_MANUAL,BROKEN,AUTO_BROKEN,PENDING_EXCEPTION
# STATUS_SET_ROLLUP=ACTIVE,PAID,PAID_MANUAL,BROKEN,AUTO_BROKEN,PENDING_EXCEPTION,REJECTED
# STATUS_SET_BREAK_CURVE=ACTIVE,PAID,PAID_MANUAL,BROKEN
GRACE_DAYS=3
EXCLUDED_AGENT_PATTERNS=system%,test%
EFFECTIVENESS_EXCLUDED_AGENT_PATTERNS=%system%,%test%
EFFECTIVENESS_FLOOR_DATE=2020-01-01
EFFECTIVENESS_DETAIL_ROW_LIMIT=250
BREAK_CURVE_EDGES=7,21,45,90
BENCHMARK_MIN_DAILY_ATTEMPTS=4
BENCHMARK_MIN_ACTIVE_DAYS=6
EFFECTIVENESS_MIN_SLIPS_PER_AGENT_MONTH=8
PERFORMANCE_DEFAULT_DAYS=30
PRODUCTIVITY_QUERY_OPTION=
AGREEMENTS_DEFAULT_LIMIT=200
AGREEMENTS_MAX_LIMIT=2000

# Targets upload
TARGETS_DIR=data/targets
TARGETS_UPLOAD_MAX_BYTES=10485760
TARGET_GROUP_NAMES=Group A,Group B

# Regression endpoint
REGRESSION_MAX_POINTS=5000
